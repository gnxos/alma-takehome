# Local dev/tests: SQLite. Production: MySQL, e.g.
# DATABASE_URL=mysql+pymysql://user:password@host:3306/alma
DATABASE_URL=sqlite:///./leads.db
UPLOAD_DIR=./uploads
CORS_ORIGINS=http://localhost:3000

# Lead-notification emails: EmailService supports three backends, selected
# via EMAIL_BACKEND.
# - "smtp" (default here): local dev — points at a local Mailpit instance
#   (https://mailpit.axllent.org) by default; run `docker compose up mailpit`
#   (or the standalone mailpit binary) and view caught mail at
#   http://localhost:8025.
# - "resend": production — set EMAIL_BACKEND=resend and RESEND_API_KEY
#   (never commit a real key) to send via Resend's HTTP API instead.
# - "preview": logs the email instead of sending; used automatically when
#   EMAIL_BACKEND=resend but RESEND_API_KEY is unset.
RESEND_API_KEY=
EMAIL_FROM=Alma <onboarding@alma.example.com>
ATTORNEY_EMAIL=attorney@alma.example.com
FRONTEND_URL=http://localhost:3000

EMAIL_BACKEND=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_TIMEOUT_SECONDS=10

# The one hardcoded attorney account for the internal dashboard. Override
# ATTORNEY_PASSWORD and JWT_SECRET for anything beyond local dev.
ATTORNEY_PASSWORD=Alma123!
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_EXPIRE_MINUTES=1440
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
