# Local dev/tests: SQLite. Production: MySQL, e.g.
# DATABASE_URL=mysql+pymysql://user:password@host:3306/alma
DATABASE_URL=sqlite:///./leads.db
UPLOAD_DIR=./uploads
CORS_ORIGINS=http://localhost:3000

# Lead-notification emails are sent over SMTP.
# Local dev/tests: Mailpit (https://mailpit.axllent.org) — run
# `docker compose up mailpit` (or the standalone mailpit binary) and view
# caught mail at http://localhost:8025. Defaults below already point here.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false

# Production: Resend's SMTP relay.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USERNAME=resend
# SMTP_PASSWORD=<your Resend API key>
# SMTP_USE_TLS=true

EMAIL_FROM=Alma <onboarding@alma.example.com>
ATTORNEY_EMAIL=attorney@alma.example.com

# The one hardcoded attorney account for the internal dashboard. Override
# ATTORNEY_PASSWORD and JWT_SECRET for anything beyond local dev.
ATTORNEY_PASSWORD=Alma123!
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_EXPIRE_MINUTES=1440
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
