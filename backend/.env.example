DATABASE_URL=sqlite:///./leads.db
UPLOAD_DIR=./uploads
CORS_ORIGINS=http://localhost:3000

# Leave RESEND_API_KEY unset to skip sending email (e.g. local dev/tests).
EMAIL_FROM=Alma <onboarding@resend.dev>
