DATABASE_URL=sqlite:///./leads.db
UPLOAD_DIR=./uploads
CORS_ORIGINS=http://localhost:3000

# Production email delivery (never commit a real API key).
RESEND_API_KEY=
EMAIL_FROM=
ATTORNEY_EMAIL=
FRONTEND_URL=http://localhost:3000

# Use EMAIL_BACKEND=smtp with the local Mailpit container. Use `resend` in
# production; without RESEND_API_KEY it falls back to a safe log preview.
EMAIL_BACKEND=preview
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_TIMEOUT_SECONDS=10

# The one hardcoded attorney account for the internal dashboard. Override
# ATTORNEY_PASSWORD and JWT_SECRET for anything beyond local dev.
ATTORNEY_PASSWORD=Alma123!
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_EXPIRE_MINUTES=1440
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
